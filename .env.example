# ==============================================================================
# DREAM HOME DECOR - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase Project Credentials (from your Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Vercel Keep-Alive Cron Secret (Optional, for protecting /api/cron/keep-alive)
CRON_SECRET=your-random-cron-secret-token

# Public Store URL (for social sharing & order links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
