# ==============================================================================
# DREAM HOME DECOR - ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env.local and populate with your production secrets.
# NEVER commit .env or .env.local to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Project Credentials
# ------------------------------------------------------------------------------
# From your Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# SERVER-ONLY: Used by Server Actions and Admin clients to bypass RLS securely
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. Authentication & Admin Security (Edge HMAC-SHA256 & bcrypt)
# ------------------------------------------------------------------------------
# Generate a strong 32+ character random string (e.g. `openssl rand -base64 32`)
AUTH_SECRET=your-minimum-32-character-random-secret-key-for-session-tokens

# Admin Multi-Tier Roles: Owner (all), Manager (catalog & orders), Staff (orders only)
# Passwords should be stored as bcrypt hashes.
# To generate a bcrypt hash: `node -e "console.log(require('bcryptjs').hashSync('YourStrongPassword', 10))"`
ADMIN_OWNER_EMAIL=owner@dreamhomedecor.com
ADMIN_OWNER_PASSWORD_HASH=$2a$10$exampleOwnerHashReplaceWithRealBcryptHash
# Or for quick dev setup:
# ADMIN_OWNER_PASSWORD=YourStrongOwnerPassword2026!

ADMIN_MANAGER_EMAIL=manager@dreamhomedecor.com
ADMIN_MANAGER_PASSWORD_HASH=$2a$10$exampleManagerHashReplaceWithRealBcryptHash
# ADMIN_MANAGER_PASSWORD=YourStrongManagerPassword2026!

ADMIN_STAFF_EMAIL=staff@dreamhomedecor.com
ADMIN_STAFF_PASSWORD_HASH=$2a$10$exampleStaffHashReplaceWithRealBcryptHash
# ADMIN_STAFF_PASSWORD=YourStrongStaffPassword2026!

# ------------------------------------------------------------------------------
# 3. Storefront & Site URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://dream-home-decor.vercel.app

# ------------------------------------------------------------------------------
# 4. Background Jobs & Cron Security
# ------------------------------------------------------------------------------
# Protects /api/cron/keep-alive from unauthorized calls
CRON_SECRET=your-random-cron-secret-token

# ------------------------------------------------------------------------------
# 5. Optional Integrations (Free tiers)
# ------------------------------------------------------------------------------
# ImageKit (Optional: if uploading new product images directly to ImageKit CDN)
# NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=your-imagekit-public-key
# IMAGEKIT_PRIVATE_KEY=your-imagekit-private-key
# NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# Resend (Optional: for sending order confirmation emails)
# RESEND_API_KEY=re_your_resend_api_key

# ------------------------------------------------------------------------------
# 6. Google Drive Integration (Phase 3)
# ------------------------------------------------------------------------------
# Optional Google Cloud Console API Key with "Google Drive API v3" enabled.
# Allows automatic listing of files inside public Google Drive folders.
# Never exposed to client-side browsers (Server-Only).
# If not provided, admin can paste direct Google Drive file share links manually.
# GOOGLE_DRIVE_API_KEY=AIzaSyYourGoogleDriveApiKeyHere

# ------------------------------------------------------------------------------
# 7. Bangladesh Conversion, Analytics & Courier (Phase 8)
# ------------------------------------------------------------------------------
# Meta (Facebook) Pixel & Server-Side Conversions API (CAPI)
# NEXT_PUBLIC_FACEBOOK_PIXEL_ID=1234567890123456
# META_CAPI_ACCESS_TOKEN=EAAG...your_meta_system_user_token

# Google Analytics 4 Measurement ID
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Bangladeshi SMS Gateway (Greenweb, BulkSMS BD, Alpha SMS, etc.)
# SMS_API_KEY=your_sms_gateway_api_key
# SMS_SENDER_ID=DreamHome
# SMS_GATEWAY_URL=https://api.sms-provider.com.bd/send

# Steadfast Courier Service API
# STEADFAST_API_KEY=your_steadfast_api_key
# STEADFAST_SECRET_KEY=your_steadfast_secret_key
# STEADFAST_BASE_URL=https://portal.steadfast.com.bd/api/v1
